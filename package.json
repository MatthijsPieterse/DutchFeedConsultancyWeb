{
  "name": "dutch-feed-consultancy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run validate:content && vite build",
    "preview": "vite preview",
    "format": "oxfmt AGENTS.md index.html package.json tsconfig.json vite.config.ts src content scripts CONTENT_GUIDE.md",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "front-matter": "^4.0.2",
    "marked": "^18.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
